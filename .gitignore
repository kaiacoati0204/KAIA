# Segredos / credenciais
Backend/.env
.env
.venv
# Config do frontend (tem a URL e a chave do Supabase).
# O modelo versionado é o Frontend/config.example.js.
Frontend/config.js

# Python
__pycache__/
*.pyc
venv/
.venv/

# Logs e saídas de runtime
server.log
*.output

# Config pessoal do Claude Code 
.claude/settings.local.json

# Dados locais antigos (antes do Supabase)
*.jsonl

# Artefatos de ML regeneráveis (o v2 vem do gerar_base_v2.py, seed fixa)
ml/artifacts/*.pkl
# Estado de runtime do Thompson Sampling (alpha/beta mutáveis)
ml/artifacts/thompson_params.json
# v2 é regenerável pelo gerador (seed fixa) — versiona só o gerador, não os artefatos.
ml/models/modelo_rf_v2.pkl
ml/artifacts/metricas_v2.json
# Modelo 1 (risco de perda de foco): regerável com `python ml/gerar_risco.py`
ml/models/modelo_risco.pkl
ml/artifacts/metricas_risco.json
# Saídas das medições de questões (verificar_cache, teste_impostor) — o impostor traz gabarito
ml/artifacts/defeitos/
ml/artifacts/impostor/
# checkpoints do Jupyter
.ipynb_checkpoints/

# Cobertura / cache do pytest
.coverage
.pytest_cache/
htmlcov/

# Node / testes de front (Vitest). package-lock.json É versionado (CI reproduzível).
node_modules/

# Saídas do Playwright (e2e): REGERADAS a cada `playwright test`. Estavam
# versionadas por engano (o index.html sozinho era 23% do repo).
e2e/playwright-report/
e2e/test-results/

# Documentação pessoal (explicação da arquitetura) — não versionar, é só da dona do projeto
docs/

# Instruções pessoais do Claude Code — não versionar (fica só local)
/CLAUDE.md

# Resultados do council — análise pessoal da dona do projeto, não versionar
council-report-*.html
council-transcript-*.md
